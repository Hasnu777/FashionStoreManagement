namespace ca.mcgill.ecse.fashionstoremanagement.model;

class Order {
    String pendingAssigneeUsername;
    boolean pendingUsePoints = false;

    state {

        UnderConstruction {
            checkout(int totalCost)
                [this.numberOfOrderItems() > this.minimumNumberOfOrderItems()]
                / {setTotalCost(totalCost);}
                -> Pending;
            cancelOrder()
                -> Cancelled;
        }

        Pending {
            pay(int finalCost, int pointsUsed, int pointsAwarded, Date datePlaced)
            / {
                setFinalCost(finalCost);
                setPointsUsedInPayment(pointsUsed);
                setPointsAwarded(pointsAwarded);
                setDatePlaced(datePlaced);
            }
            -> Placed;
            cancelOrder()
                -> Cancelled;
        }

        Placed {
            assignEmployee(Employee employeeToAssign)
                [!hasOrderAssignee()]
                / {setOrderAssignee(employeeToAssign);}
                -> InPreparation;
            cancelOrder()
                -> Cancelled;
        }

        InPreparation {
            assignEmployee(Employee employeeToAssign)
                [hasOrderAssignee()]
                / {setOrderAssignee(employeeToAssign);}
                -> InPreparation;
            finishAssembly()
                -> ReadyForDelivery;
        }

        ReadyForDelivery {
            deliver(Date orderDeliveryDeadline)
                [isDeliveryDay(orderDeliveryDeadline)]
                -> Delivered;
        }

        Delivered {}

        Cancelled {}

    }

    boolean isDeliveryDay(Date orderDeliveryDeadline) Java {
        Date todaysDate = new Date(System.currentTimeMillis());
        return !orderDeliveryDeadline.after(todaysDate);
    }

}
