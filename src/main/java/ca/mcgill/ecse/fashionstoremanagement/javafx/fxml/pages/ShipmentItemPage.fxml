<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>

<GridPane hgap="10.0" vgap="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ca.mcgill.ecse.fashionstoremanagement.javafx.fxml.controllers.ShipmentItemPageController">
    <columnConstraints>
        <ColumnConstraints hgrow="SOMETIMES" prefWidth="150.0" />
        <ColumnConstraints hgrow="ALWAYS" prefWidth="200.0" />
        <ColumnConstraints hgrow="SOMETIMES" prefWidth="150.0" />
    </columnConstraints>
    <children>
        <Label text="Shipment Number:" />
        <TextField fx:id="shipmentNumberField" promptText="Shipment Number" GridPane.columnIndex="1" />

        <Label text="Item Name:" GridPane.rowIndex="1" />
        <TextField fx:id="itemNameField" promptText="Item Name" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label text="Size:" GridPane.rowIndex="2" />
        <TextField fx:id="sizeField" promptText="e.g. M, L, XL" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <Button maxWidth="1.7976931348623157E308" text="Add Item" onAction="#addItemClicked" GridPane.rowIndex="3" GridPane.hgrow="ALWAYS" />
        <Button maxWidth="1.7976931348623157E308" text="Remove Item" onAction="#removeItemClicked" GridPane.columnIndex="1" GridPane.rowIndex="3" GridPane.hgrow="ALWAYS" />

        <Label fx:id="statusLabel" text="" GridPane.columnIndex="1" GridPane.rowIndex="4" />
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</GridPane>