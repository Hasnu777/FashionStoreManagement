<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>

<GridPane hgap="10.0" vgap="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ca.mcgill.ecse.fashionstoremanagement.javafx.fxml.controllers.AssignOrderPageController">
    <columnConstraints>
        <ColumnConstraints hgrow="SOMETIMES" prefWidth="150.0" />
        <ColumnConstraints hgrow="ALWAYS" prefWidth="200.0" />
        <ColumnConstraints hgrow="SOMETIMES" prefWidth="150.0" />
    </columnConstraints>
    <children>
        <Label text="Order Number:" />
        <TextField fx:id="orderNumberField" promptText="Order Number" GridPane.columnIndex="1" />

        <Label text="Employee Username:" GridPane.rowIndex="1" />
        <TextField fx:id="employeeUsernameField" promptText="Employee Username" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Button maxWidth="1.7976931348623157E308" text="Assign Order" onAction="#assignClicked" GridPane.rowIndex="2" GridPane.hgrow="ALWAYS" />

        <Label fx:id="statusLabel" text="" GridPane.columnIndex="1" GridPane.rowIndex="2" />
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</GridPane>