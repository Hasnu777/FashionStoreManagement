<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ca.mcgill.ecse.fashionstoremanagement.javafx.fxml.controllers.OrderActionsController">
    <!-- CREATE ORDER -->
    <TitledPane expanded="true" text="Create Order">
        <content>
            <GridPane hgap="10" maxWidth="Infinity" vgap="10">

                <columnConstraints>
                    <ColumnConstraints percentWidth="40" />
                    <ColumnConstraints percentWidth="60" />
                </columnConstraints>

                <Label text="Username:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="usernameField" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="Deadline:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <ChoiceBox fx:id="deadlineField" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Button maxWidth="Infinity" styleClass="primary-button" text="Create Order" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="2" />
            <rowConstraints>
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
            </rowConstraints>
            </GridPane>
        </content>
    </TitledPane>

    <!-- MANAGE ITEMS -->
    <TitledPane expanded="false" text="Manage Order Items">
        <content>
            <GridPane hgap="10" maxWidth="Infinity" vgap="10">

                <columnConstraints>
                    <ColumnConstraints percentWidth="40" />
                    <ColumnConstraints percentWidth="60" />
                </columnConstraints>

                <Label text="Order ID:" GridPane.rowIndex="0" />
                <TextField fx:id="orderNumberField" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="Item Name:" GridPane.rowIndex="1" />
                <TextField fx:id="itemNameField" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Size:" GridPane.rowIndex="2" />
                <ChoiceBox fx:id="sizeBox" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label text="Quantity:" GridPane.rowIndex="3" />
                <TextField fx:id="quantityField" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                <HBox spacing="10" GridPane.columnSpan="2" GridPane.rowIndex="4">
                    <Button maxWidth="Infinity" text="Add Item" HBox.hgrow="ALWAYS" />
                    <Button maxWidth="Infinity" text="Update Item" HBox.hgrow="ALWAYS" />
                </HBox>
            <rowConstraints>
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
            </rowConstraints>

            </GridPane>
        </content>
    </TitledPane>

    <!-- ORDER ACTIONS -->
    <TitledPane expanded="false" text="Order Actions">
        <content>
            <VBox spacing="10">

                <TextField fx:id="orderIdActionField" promptText="Order ID" />

                <Button maxWidth="Infinity" text="Checkout" />
                <CheckBox fx:id="usePointsCheckBox" text="Use Points"/>
                <Button maxWidth="Infinity" text="Pay" />
                <Button maxWidth="Infinity" text="Deliver" />
                <Button maxWidth="Infinity" text="Assign Employee" />
                <Button maxWidth="Infinity" text="Cancel Order" />

            </VBox>
        </content>
    </TitledPane>
   <Label text="" fx:id="statusLabel"/>
</VBox>
