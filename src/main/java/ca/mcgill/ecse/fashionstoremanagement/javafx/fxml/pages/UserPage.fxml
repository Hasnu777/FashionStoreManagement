<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>

<AnchorPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ca.mcgill.ecse.fashionstoremanagement.javafx.fxml.controllers.UserPageController">
    <children>
        <BorderPane AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
                    AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <center>
                <TableView fx:id="userTable" BorderPane.alignment="CENTER">
                    <columns>
                        <TableColumn fx:id="colUsername" prefWidth="100.0" text="Username" />
                        <TableColumn fx:id="colName" prefWidth="100.0" text="Name" />
                        <TableColumn fx:id="colNumber" prefWidth="100.0" text="Phone Number" />
                        <TableColumn fx:id="colRole" prefWidth="100.0" text="Roles" />
                    </columns>
                </TableView>
            </center>
            <bottom>
                <Pagination fx:id="pagination" prefHeight="51.0" prefWidth="600.0" BorderPane.alignment="CENTER" />
            </bottom>
        </BorderPane>
    </children>
</AnchorPane>
